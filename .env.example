POSTGRES_DB=kapeldiner_service_db
POSTGRES_USER=kapeldiner
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value

PUBLIC_BASE_URL=https://your-host.example/
HTTP_PORT=8080
# Keep the default for a reverse proxy running on this server.
HTTP_BIND_ADDRESS=127.0.0.1

# Set these only for the first startup, then remove them.
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Optional SMTP settings (STARTTLS is required by the API).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Капельдинер
SMTP_USERNAME=
SMTP_PASSWORD=
